{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Tools",
  "version": "../package.json",
  "identifier": "com.opentools.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Open Tools 工具百宝箱",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0NEREMjlBQjhFQTU3MzcKUldRM1YrcTRtdEpObExuanRFaElJRTA1ckl0OU16UmtQamVOYXBPeGFCS1lWQnVUaGpZYUc1M28K",
      "endpoints": [
        "https://gitee.com/bulua/open-tools/raw/updater/latest.json",
        "https://github.com/Bulua/open-tools/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
